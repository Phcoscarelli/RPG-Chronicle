generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User {

  // Primary Key
  id  String @id @default(cuid())

  //Authentication
  username String
  email String @unique
  password String
  
  //Relations
  campaignMembers campaignMember[]

  //Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Campaign {
  //Primary Key 
  id String @id @default(cuid())

  //Information
  name String 
  rpgSystem String
  description String 

  //Images
  coverImageUrl String?

  //Settings
  isPublic Boolean @default(false)

  //Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}